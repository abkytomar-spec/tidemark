{
  "name": "tidemark-cloud",
  "version": "1.0.0",
  "description": "Tidemark: a private, rewarding life planner \u2014 every day leaves a mark.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "typecheck": "tsc -b --pretty false",
    "test:php": "docker compose run --rm php php tests/php/run.php",
    "test:e2e": "docker compose run --rm php php -r \"require 'tests/php/bootstrap.php'; fresh_database();\" && playwright test",
    "package:hostinger": "node scripts/package-hostinger.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "date-fns": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
